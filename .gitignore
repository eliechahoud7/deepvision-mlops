# Virtual environments
.venv/
venv/
env/

# Python caches and compiled files
__pycache__/
*.py[cod]
*$py.class

# Environment variables and secrets
.env
.env.*
!.env.example

# Jupyter
.ipynb_checkpoints/

# Test and code-quality caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Datasets and local data (root-anchored so source packages named "data" are not ignored)
/data/

# Model weights and checkpoints (root-anchored so source packages named "models" are not ignored)
*.pt
*.pth
*.onnx
*.ckpt
/models/

# Logs and temporary files
*.log
logs/
*.tmp
tmp/

# MLflow local tracking
mlruns/
mlartifacts/

# DVC
.dvc/cache/
.dvc/tmp/

# IDEs
.vscode/
.idea/

# Operating system files
.DS_Store
Thumbs.db
desktop.ini
