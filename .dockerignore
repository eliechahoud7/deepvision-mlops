# Allow-list: the build context contains only what the image build needs.
# Everything else (data, checkpoints, MLflow runs, DVC cache, .venv, .git, reports,
# tests) stays out of the context and out of the image.
*

!Dockerfile
!pyproject.toml
!README.md
!requirements.txt
!requirements-serve.txt
!src/
# Frontend image (frontend.Dockerfile). Only the config file, never .streamlit/secrets.toml.
!frontend.Dockerfile
!requirements-frontend.txt
!.streamlit/config.toml

**/__pycache__
**/*.py[cod]
**/*.egg-info
